# Optional. Raises GitHub API limits (60/h -> 5000/h) and enables the contribution calendar.
# Server-side only: never prefix with NEXT_PUBLIC_. Use a fine-grained token with NO scopes
# (public read-only) -- "read:user" is only needed for the contribution calendar.
GITHUB_TOKEN=
# Used for canonical URL, sitemap and Open Graph. Set to your deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
